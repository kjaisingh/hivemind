{
  "name": "hivemind",
  "version": "1.1.0",
  "private": true,
  "description": "Multiplayer social guessing game",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:ui": "playwright test --config=playwright.ui.config.js",
    "test:e2e": "playwright test",
    "check:syntax": "find server supabase -name '*.js' -exec node --check {} +",
    "check": "npm run check:syntax && npm run lint && npm run test:unit && npm run build",
    "db:seed": "node supabase/seed.js",
    "setup": "npm run db:seed"
  },
  "keywords": [
    "multiplayer",
    "party-game",
    "react",
    "express"
  ],
  "author": "kjaisingh",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
