PORT=3001
BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Required — Supabase (Postgres). service_role key bypasses RLS by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Required — random string used to sign session cookies
SESSION_SECRET=<random string>

# Optional — enables Google OAuth sign-in; email/password always works without these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional — enables reminder emails; without all five set, sends are skipped
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared password for demo accounts seeded by `npm run setup` (auto-generated + printed once if unset)
DEMO_PASSWORD=
