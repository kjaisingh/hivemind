PORT=3001
BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Required — Supabase (Postgres). service_role key bypasses RLS by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Required — random string used to sign session cookies
SESSION_SECRET=<random string>

# Optional — enables reminder/notification emails via Resend's HTTPS API;
# without both set, sends are skipped and logged instead
SMTP_PASS=<Resend API key>
SMTP_FROM=

# Shared password for demo accounts seeded by `npm run setup` (auto-generated + printed once if unset)
DEMO_PASSWORD=
