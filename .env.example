PORT=3001
BASE_URL=http://localhost:5183
CLIENT_URL=http://localhost:5183

# Optional: backend URL the frontend calls in local development (defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Required: Supabase (Postgres). service_role key bypasses RLS by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Required: random string used to sign session cookies
SESSION_SECRET=<random string>

# Optional: enables reminder/notification emails via Resend's HTTPS API;
# without both set, email controls remain disabled
RESEND_API_KEY=<Resend API key>
# Legacy alias: SMTP_PASS
SMTP_FROM=

# Required safety latch for the destructive demo reset. Use only with a disposable database.
CONFIRM_DEMO_RESET=RESET_ALL_HIVEMIND_DATA

# Shared password for demo accounts seeded by `npm run setup` (auto-generated + printed once if unset)
DEMO_PASSWORD=
